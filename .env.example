# Copy to `.env` (which is gitignored) and adjust. No real secrets belong in git.
# The MVP runs fully offline on synthetic data and needs none of these set.

# Directory holding team-provided raw review exports (CSV/JSON). Never committed.
CRI_DATA_RAW_DIR=data/raw

# Browser origins allowed to call the API (cri.server), comma-separated.
# CRI_API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional override for the aspect taxonomy file.
# CRI_ASPECTS_PATH=src/cri/resources/aspects.yaml

# Sentiment backend: rule (default) | learned (trained linear model) | transformer.
# CRI_MODEL_BACKEND=rule
# Model file for the learned backend; default: the packaged open-data model.
# A model trained on local data stays outside git, e.g.:
# CRI_LEARNED_MODEL_PATH=data/raw/external/models/sentiment_region.npz
# Placeholder for an OPTIONAL LLM backend (roadmap, not used). Do not commit real keys.
# CRI_LLM_API_KEY=
